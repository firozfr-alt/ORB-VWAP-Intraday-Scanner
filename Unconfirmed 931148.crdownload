import streamlit as st
import pandas as pd
import numpy as np
import yfinance as yf
from datetime import datetime
import pytz
import ta

# ==========================================
# 1. PAGE CONFIGURATION & STYLING
# ==========================================
st.set_page_config(
    page_title="Pro ORB + VWAP Intraday Screener",
    page_icon="⚡",
    layout="wide",
    initial_sidebar_state="expanded"
)

st.markdown("""
<style>
    .stDataFrame { border-radius: 8px; overflow: hidden; }
</style>
""", unsafe_allow_html=True)

st.title("⚡ Pro ORB (9:15–9:30) + VWAP Intraday Screener")
st.caption("Live scan across NSE stocks checking Opening Range breakouts, institutional VWAP support, RSI momentum, and volume conviction.")

# ==========================================
# 2. WATCHLISTS & SIDEBAR CONTROLS
# ==========================================
WATCHLIST_PRESETS = {
    "Nifty 50 Core": [
        "RELIANCE.NS", "TCS.NS", "HDFCBANK.NS", "INFY.NS", "ICICIBANK.NS",
        "SBIN.NS", "BHARTIARTL.NS", "ITC.NS", "KOTAKBANK.NS", "LT.NS",
        "AXISBANK.NS", "TATAMOTORS.NS", "MARUTI.NS", "SUNPHARMA.NS", "TITAN.NS",
        "BAJFINANCE.NS", "TATASTEEL.NS", "HINDUNILVR.NS", "NTPC.NS", "POWERGRID.NS"
    ],
    "High-Beta / F&O Momentum": [
        "TATAMOTORS.NS", "BAJFINANCE.NS", "ADANIENT.NS", "ADANIPORTS.NS",
        "HINDALCO.NS", "TATASTEEL.NS", "VEDL.NS", "DLF.NS", "INDUSINDBK.NS",
        "JINDALSTEL.NS", "CANBK.NS", "FEDERALBNK.NS", "MOTHERSON.NS", "ZEEL.NS"
    ],
    "Banking & Financials": [
        "HDFCBANK.NS", "ICICIBANK.NS", "SBIN.NS", "KOTAKBANK.NS", "AXISBANK.NS",
        "INDUSINDBK.NS", "BANKBARODA.NS", "PNB.NS", "CANBK.NS", "BAJFINANCE.NS", "BAJAJFINSV.NS"
    ]
}

st.sidebar.header("🎯 Strategy Settings")

selected_preset = st.sidebar.selectbox("Choose Universe", list(WATCHLIST_PRESETS.keys()) + ["Custom Symbols"])

if selected_preset == "Custom Symbols":
    custom_input = st.sidebar.text_area(
        "Enter NSE Symbols (comma-separated with .NS)",
        value="RELIANCE.NS, TCS.NS, HDFCBANK.NS, INFY.NS, TATAMOTORS.NS",
        height=100
    )
    symbols_to_scan = [s.strip().upper() for s in custom_input.split(",") if s.strip()]
else:
    symbols_to_scan = WATCHLIST_PRESETS[selected_preset]

st.sidebar.markdown("---")
st.sidebar.subheader("Filter Tuning")

vol_mult = st.sidebar.slider("Volume Surge Multiplier (vs 15-SMA)", 1.0, 2.5, 1.2, 0.1)

col_rsi1, col_rsi2 = st.sidebar.columns(2)
with col_rsi1:
    buy_rsi_min = st.number_input("BUY RSI Min", value=55, min_value=30, max_value=70)
with col_rsi2:
    sell_rsi_max = st.number_input("SELL RSI Max", value=45, min_value=20, max_value=60)

auto_refresh = st.sidebar.checkbox("Enable Auto-Refresh (every 60s)", value=False)
if auto_refresh:
    st.sidebar.info("Auto-refresh active.")
    st.experimental_fragment(run_every=60)

# ==========================================
# 3. TECHNICAL ENGINE
# ==========================================
def analyze_stock(ticker_symbol: str):
    try:
        stock = yf.Ticker(ticker_symbol)
        df = stock.history(period="5d", interval="15m")

        if df.empty or len(df) < 25:
            return None

        # Convert index to Indian Standard Time (IST)
        ist = pytz.timezone("Asia/Kolkata")
        if df.index.tz is None:
            df.index = df.index.tz_localize("UTC").tz_convert(ist)
        else:
            df.index = df.index.tz_convert(ist)

        latest_date = df.index[-1].date()
        today_df = df[df.index.date == latest_date].copy()

        # Requires completed 9:15-9:30 range candle plus at least one subsequent bar
        if len(today_df) < 2:
            return {"error": "Waiting for 9:45 AM candle completion."}

        # 1. Opening Range (First 15-minute candle: 9:15-9:30)
        or_bar = today_df.iloc[0]
        or_high = float(or_bar["High"])
        or_low = float(or_bar["Low"])

        # 2. Daily Intraday VWAP
        today_df["TP"] = (today_df["High"] + today_df["Low"] + today_df["Close"]) / 3
        today_df["TPV"] = today_df["TP"] * today_df["Volume"]
        cum_tpv = today_df["TPV"].cumsum()
        cum_vol = today_df["Volume"].cumsum()
        today_df["VWAP"] = cum_tpv / cum_vol.replace(0, np.nan)

        # 3. RSI & Volume Moving Average
        df["RSI"] = ta.momentum.rsi(df["Close"], window=14)
        df["VOL_SMA"] = df["Volume"].rolling(window=15).mean()

        latest_idx = today_df.index[-1]
        vwap_latest = float(today_df.loc[latest_idx, "VWAP"])
        latest = df.loc[latest_idx]

        ltp = float(latest["Close"])
        rsi = float(latest["RSI"])
        vol = float(latest["Volume"])
        vol_avg = float(latest["VOL_SMA"]) if not np.isnan(latest["VOL_SMA"]) else 1.0

        return {
            "Symbol": ticker_symbol.replace(".NS", ""),
            "LTP": round(ltp, 2),
            "OR_High": round(or_high, 2),
            "OR_Low": round(or_low, 2),
            "VWAP": round(vwap_latest, 2),
            "RSI": round(rsi, 1),
            "Volume": int(vol),
            "Vol_SMA": int(vol_avg),
            "Vol_Ratio": round(vol / vol_avg, 2) if vol_avg > 0 else 1.0
        }
    except Exception:
        return None

# ==========================================
# 4. SCAN EXECUTION & RESULTS
# ==========================================
scan_col1, _ = st.columns([1, 4])
with scan_col1:
    trigger_scan = st.button("🚀 Run Live Scan Now", type="primary", use_container_width=True)

if trigger_scan or auto_refresh:
    buy_signals = []
    sell_signals = []
    neutral_list = []

    progress_bar = st.progress(0)
    status_msg = st.empty()

    for i, sym in enumerate(symbols_to_scan):
        status_msg.text(f"Scanning {sym} ({i+1}/{len(symbols_to_scan)})...")
        progress_bar.progress((i + 1) / len(symbols_to_scan))

        data = analyze_stock(sym)
        if not data or "error" in data:
            continue

        ltp = data["LTP"]
        or_h = data["OR_High"]
        or_l = data["OR_Low"]
        vwap = data["VWAP"]
        rsi = data["RSI"]
        vol_ratio = data["Vol_Ratio"]

        has_vol = vol_ratio >= vol_mult

        # --- OPTIMIZED 4-FILTER MOMENTUM LOGIC ---
        is_buy = (ltp > or_h) and (ltp > vwap) and (rsi >= buy_rsi_min) and has_vol
        is_sell = (ltp < or_l) and (ltp < vwap) and (rsi <= sell_rsi_max) and has_vol

        if is_buy:
            sl = or_l
            risk = round(ltp - sl, 2)
            buy_signals.append({
                "Stock": data["Symbol"],
                "LTP (₹)": ltp,
                "OR High": or_h,
                "Stop-Loss (₹)": sl,
                "Target 1 (1.5R)": round(ltp + (1.5 * risk), 2),
                "Target 2 (2R)": round(ltp + (2.0 * risk), 2),
                "VWAP": vwap,
                "RSI": rsi,
                "Vol Surge": f"{vol_ratio}x"
            })
        elif is_sell:
            sl = or_h
            risk = round(sl - ltp, 2)
            sell_signals.append({
                "Stock": data["Symbol"],
                "LTP (₹)": ltp,
                "OR Low": or_l,
                "Stop-Loss (₹)": sl,
                "Target 1 (1.5R)": round(ltp - (1.5 * risk), 2),
                "Target 2 (2R)": round(ltp - (2.0 * risk), 2),
                "VWAP": vwap,
                "RSI": rsi,
                "Vol Surge": f"{vol_ratio}x"
            })
        else:
            neutral_list.append({
                "Stock": data["Symbol"],
                "LTP": ltp,
                "OR High": or_h,
                "OR Low": or_l,
                "VWAP": vwap,
                "RSI": rsi,
                "Vol Surge": f"{vol_ratio}x"
            })

    status_msg.success(f"Scan finished at {datetime.now(pytz.timezone('Asia/Kolkata')).strftime('%H:%M:%S')} IST")
    progress_bar.empty()

    # --- DISPLAY METRICS & TABLES ---
    m1, m2, m3 = st.columns(3)
    m1.metric("🟢 BUY Candidates", len(buy_signals))
    m2.metric("🔴 SELL Candidates", len(sell_signals))
    m3.metric("⚪ Neutral / In-Range", len(neutral_list))

    tab_buy, tab_sell, tab_all = st.tabs(["🟢 Long Breakouts (BUY)", "🔴 Short Breakdowns (SELL)", "📊 All Monitored Stocks"])

    with tab_buy:
        if buy_signals:
            st.dataframe(pd.DataFrame(buy_signals), use_container_width=True)
            st.info("💡 **Execution Rule (BUY):** Confirmed close above OR High & VWAP. Stop loss at OR Low. Trail VWAP after 1R. Hard square-off by 3:15 PM.")
        else:
            st.write("No stocks currently satisfy all bullish criteria.")

    with tab_sell:
        if sell_signals:
            st.dataframe(pd.DataFrame(sell_signals), use_container_width=True)
            st.info("💡 **Execution Rule (SELL):** Confirmed close below OR Low & VWAP. Stop loss at OR High. Trail VWAP after 1R. Hard square-off by 3:15 PM.")
        else:
            st.write("No stocks currently satisfy all bearish criteria.")

    with tab_all:
        if neutral_list:
            st.dataframe(pd.DataFrame(neutral_list), use_container_width=True)